# Reuse the already installed control image and its layers on the lab machine.
ARG DOGI_CONTROL_BASE=control-control:latest
FROM ${DOGI_CONTROL_BASE}

ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python

COPY requirements-vla.lock /tmp/requirements-vla.lock
RUN uv python install 3.11 && \
    uv venv --python 3.11 /opt/vla && \
    uv pip sync --python /opt/vla/bin/python --no-cache \
    --index-strategy unsafe-best-match /tmp/requirements-vla.lock

# All transitive dependencies except psutil are already in requirements-vla.lock.
# --no-deps prevents the adapter install from replacing the Volta torch wheel.
COPY cache/lightnav/wheels/lightnav_mujoco*.whl /tmp/vla-wheels/
RUN uv pip install --python /opt/vla/bin/python --no-cache --no-deps \
        peft==0.22.0 accelerate==1.16.0 psutil==7.2.2 /tmp/vla-wheels/*.whl && \
    uv pip check --python /opt/vla/bin/python && \
    /opt/vla/bin/python -c "import torch; assert torch.__version__ == '2.11.0+cu126'; from lightnav_mujoco.model.lightnav_adapter import DirectActionLightNav" && \
    rm -rf /tmp/vla-wheels

COPY src/ /app/
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
# Preserve the original /opt/venv environment for the other Dogi applications.
ENV VLA_PYTHON=/opt/vla/bin/python \
    LIGHTNAV_MODEL_PATH=/models/LightNav-0 \
    LIGHTNAV_ADAPTER_PATH=/models/adapter
