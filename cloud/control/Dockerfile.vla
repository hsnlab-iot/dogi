# Reuse the already installed control image and its layers on the lab machine.
ARG DOGI_CONTROL_BASE=control-control:latest
FROM ${DOGI_CONTROL_BASE}

ARG LIGHTNAV_REVISION=3015508b70fb6e30bbd66701e94c9b916dcb8df8
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python

COPY requirements-vla.lock /tmp/requirements-vla.lock
RUN uv python install 3.11 && \
    uv venv --python 3.11 /opt/vla && \
    uv pip sync --python /opt/vla/bin/python --no-cache \
    --index-strategy unsafe-best-match /tmp/requirements-vla.lock

COPY patches/lightnav-fp16.patch /tmp/lightnav-fp16.patch
# Fetch only the files needed to build the package, without demo assets/history.
RUN git init /opt/lightnav-source && \
    git -C /opt/lightnav-source remote add origin https://github.com/lightorigins/LightNav-0.git && \
    git -C /opt/lightnav-source fetch --depth=1 --filter=blob:none origin ${LIGHTNAV_REVISION} && \
    git -C /opt/lightnav-source checkout FETCH_HEAD -- src pyproject.toml README.md LICENSE && \
    git -C /opt/lightnav-source apply /tmp/lightnav-fp16.patch && \
    uv pip install --python /opt/vla/bin/python --no-cache --no-deps --no-build-isolation /opt/lightnav-source && \
    uv pip check --python /opt/vla/bin/python && \
    rm -rf /opt/lightnav-source /tmp/lightnav-fp16.patch /tmp/requirements-vla.lock

COPY src/ /app/
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
# Preserve the original /opt/venv environment for the other Dogi applications.
ENV VLA_PYTHON=/opt/vla/bin/python \
    LIGHTNAV_MODEL_PATH=/models/LightNav-0 \
    LIGHTNAV_DTYPE=float16 \
    LIGHTNAV_ATTN=sdpa \
    VLA_MOVE=0
